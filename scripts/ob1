#!/usr/bin/env python3
"""ob1 — single-file CLI for the Open Brain (OB1) MCP server.

Vendor this file into any repo that needs to capture or search thoughts.
No deps; Python 3.10+ stdlib only. Reads creds from env vars or
~/open-brain/.env (in that order).

Required env:
  MCP_CONNECTION_URL  — full URL incl. ?key=<MCP_ACCESS_KEY>
  SUPABASE_ANON_KEY   — sent as Authorization: Bearer <anon> + apikey

Subcommands:
  capture <content>           Save a thought (use --meta repeatedly for k=v pairs)
  search  <query>             Search (default mode: hybrid)
  get     <id>                Fetch one thought by UUID
  recent                      Date-ordered recent thoughts
  stats                       Row count + oldest/newest + tools
  delete  <id>                Soft-delete (sets deleted_at)
  restore <id>                Undo a soft-delete
  update  <id>                Merge metadata onto an existing thought

Examples:
  ob1 capture "Decided to use HNSW over IVFFlat" --meta source=design --meta project=ob1
  ob1 search "indexing strategy" -n 5 --mode hybrid
  ob1 stats --pretty
  ob1 update <uuid> --meta tag=archived
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any


# ---------- Config ----------------------------------------------------------

def _load_dotenv(path: Path) -> dict[str, str]:
    if not path.exists():
        return {}
    out: dict[str, str] = {}
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, _, v = line.partition("=")
            out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        return {}
    return out


def resolve_creds() -> tuple[str, str]:
    """Return (url, anon_key). env wins over ~/open-brain/.env."""
    env = _load_dotenv(Path.home() / "open-brain" / ".env")
    url = os.environ.get("MCP_CONNECTION_URL") or env.get("MCP_CONNECTION_URL")
    anon = os.environ.get("SUPABASE_ANON_KEY") or env.get("SUPABASE_ANON_KEY")
    if not url or not anon:
        sys.exit(
            "ob1: missing creds. Set MCP_CONNECTION_URL and SUPABASE_ANON_KEY "
            "(env vars or ~/open-brain/.env)."
        )
    return url, anon


# ---------- Wire format -----------------------------------------------------

def _post(url: str, anon: str, method: str, params: dict | None = None,
          timeout: int = 30) -> dict:
    body: dict[str, Any] = {"jsonrpc": "2.0", "id": 1, "method": method}
    if params is not None:
        body["params"] = params
    req = urllib.request.Request(
        url,
        data=json.dumps(body).encode("utf-8"),
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {anon}",
            "apikey": anon,
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            return json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        try:
            payload = json.loads(e.read().decode("utf-8"))
        except Exception:
            payload = {"error": f"HTTP {e.code}: {e.reason}"}
        sys.exit(f"ob1: HTTP {e.code}: {json.dumps(payload)}")
    except (urllib.error.URLError, TimeoutError) as e:
        sys.exit(f"ob1: unreachable: {e}")


def call_tool(url: str, anon: str, name: str, arguments: dict) -> Any:
    resp = _post(url, anon, "tools/call",
                 {"name": name, "arguments": arguments})
    if "error" in resp:
        sys.exit(f"ob1: {json.dumps(resp['error'])}")
    text = resp["result"]["content"][0]["text"]
    return json.loads(text)


# ---------- Argparse helpers ------------------------------------------------

def parse_meta(pairs: list[str] | None) -> dict[str, Any]:
    """Convert ['k=v', 'n=42', 'flag=true'] into a dict, with light coercion."""
    out: dict[str, Any] = {}
    if not pairs:
        return out
    for p in pairs:
        if "=" not in p:
            sys.exit(f"ob1: --meta needs key=value (got: {p!r})")
        k, _, v = p.partition("=")
        k = k.strip()
        v = v.strip()
        # Light coercion for ints / bools — treat the rest as strings.
        if v.lower() in ("true", "false"):
            out[k] = (v.lower() == "true")
        else:
            try:
                out[k] = int(v)
            except ValueError:
                out[k] = v
    return out


def merge_meta(args_meta: list[str] | None,
               args_meta_json: str | None) -> dict[str, Any]:
    base = parse_meta(args_meta)
    if args_meta_json:
        try:
            extra = json.loads(args_meta_json)
        except json.JSONDecodeError as e:
            sys.exit(f"ob1: --meta-json is not valid JSON: {e}")
        if not isinstance(extra, dict):
            sys.exit("ob1: --meta-json must be a JSON object")
        base.update(extra)
    return base


def output(result: Any, pretty: bool) -> None:
    if pretty:
        print(json.dumps(result, indent=2, default=str))
    else:
        print(json.dumps(result, default=str))


# ---------- Subcommands -----------------------------------------------------

def cmd_capture(url: str, anon: str, args: argparse.Namespace) -> None:
    content = args.content
    if content == "-":
        content = sys.stdin.read()
    md = merge_meta(args.meta, args.meta_json)
    res = call_tool(url, anon, "capture_thought",
                    {"content": content, "metadata": md})
    output(res, args.pretty)


def cmd_search(url: str, anon: str, args: argparse.Namespace) -> None:
    res = call_tool(url, anon, "search_thoughts", {
        "query": args.query, "limit": args.limit,
        "threshold": args.threshold, "mode": args.mode,
    })
    output(res, args.pretty)


def cmd_get(url: str, anon: str, args: argparse.Namespace) -> None:
    output(call_tool(url, anon, "get_thought", {"id": args.id}), args.pretty)


def cmd_recent(url: str, anon: str, args: argparse.Namespace) -> None:
    output(call_tool(url, anon, "browse_recent", {"limit": args.limit}),
           args.pretty)


def cmd_stats(url: str, anon: str, args: argparse.Namespace) -> None:
    output(call_tool(url, anon, "stats", {}), args.pretty)


def cmd_delete(url: str, anon: str, args: argparse.Namespace) -> None:
    output(call_tool(url, anon, "delete_thought", {"id": args.id}), args.pretty)


def cmd_restore(url: str, anon: str, args: argparse.Namespace) -> None:
    output(call_tool(url, anon, "restore_thought", {"id": args.id}),
           args.pretty)


def cmd_update(url: str, anon: str, args: argparse.Namespace) -> None:
    md = merge_meta(args.meta, args.meta_json)
    if not md:
        sys.exit("ob1: update needs at least one --meta or --meta-json")
    output(
        call_tool(url, anon, "update_thought_metadata",
                  {"id": args.id, "metadata": md}),
        args.pretty,
    )


def cmd_health(url: str, anon: str, args: argparse.Namespace) -> None:
    """GET the endpoint root — quick liveness probe."""
    req = urllib.request.Request(
        url,
        headers={"Authorization": f"Bearer {anon}", "apikey": anon},
        method="GET",
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            print(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        sys.exit(f"ob1: HTTP {e.code}: {e.reason}")
    except (urllib.error.URLError, TimeoutError) as e:
        sys.exit(f"ob1: unreachable: {e}")


# ---------- main ------------------------------------------------------------

def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="ob1",
        description="Single-file CLI for the Open Brain (OB1) MCP server.",
    )
    ap.add_argument("--pretty", action="store_true",
                    help="Indent JSON output for humans.")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_cap = sub.add_parser("capture", help="Save a thought.")
    p_cap.add_argument("content", help="Content text. Use '-' to read stdin.")
    p_cap.add_argument("--meta", action="append",
                       help="Metadata key=value (repeatable).")
    p_cap.add_argument("--meta-json", help="Metadata as a single JSON object.")
    p_cap.set_defaults(fn=cmd_capture)

    p_s = sub.add_parser("search", help="Search thoughts.")
    p_s.add_argument("query")
    p_s.add_argument("-n", "--limit", type=int, default=10)
    p_s.add_argument("-t", "--threshold", type=float, default=0.0)
    p_s.add_argument("--mode", choices=["hybrid", "semantic", "lexical"],
                     default="hybrid")
    p_s.set_defaults(fn=cmd_search)

    p_g = sub.add_parser("get", help="Fetch a thought by id.")
    p_g.add_argument("id")
    p_g.set_defaults(fn=cmd_get)

    p_r = sub.add_parser("recent", help="Date-ordered recent thoughts.")
    p_r.add_argument("-n", "--limit", type=int, default=20)
    p_r.set_defaults(fn=cmd_recent)

    p_st = sub.add_parser("stats", help="Row count + health.")
    p_st.set_defaults(fn=cmd_stats)

    p_d = sub.add_parser("delete", help="Soft-delete a thought.")
    p_d.add_argument("id")
    p_d.set_defaults(fn=cmd_delete)

    p_re = sub.add_parser("restore", help="Undo a soft-delete.")
    p_re.add_argument("id")
    p_re.set_defaults(fn=cmd_restore)

    p_u = sub.add_parser("update", help="Merge metadata onto an existing thought.")
    p_u.add_argument("id")
    p_u.add_argument("--meta", action="append")
    p_u.add_argument("--meta-json")
    p_u.set_defaults(fn=cmd_update)

    p_h = sub.add_parser("health", help="GET / for service health.")
    p_h.set_defaults(fn=cmd_health)

    return ap


def main() -> None:
    args = build_parser().parse_args()
    url, anon = resolve_creds()
    args.fn(url, anon, args)


if __name__ == "__main__":
    main()
